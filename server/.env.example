PORT=4000
NODE_ENV=development
# Comma-separated allowed frontend origins (e.g., localhost and your Vercel URL)
CLIENT_URL=http://localhost:5173,https://saradhyajewels.vercel.app

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saradhya_jewels?schema=public"

# JWT Secrets
JWT_ACCESS_SECRET="super-secret-jwt-access-key-saradhya-jewels-2024"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-saradhya-jewels-2024"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Razorpay
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_test_webhook_secret"

# Admin Initial Seed
ADMIN_EMAIL="admin@saradhyajewels.com"
ADMIN_PASSWORD="AdminPassword123!"
